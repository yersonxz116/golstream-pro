# Environment Configuration for GolStream Pro (Strong IPTV)

# Server
PORT=4000
NODE_ENV=development

# Database (SQLite for local dev & tests; MySQL for production)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="mysql://stronguser:strongpass@localhost:3306/strongiptv"

# Authentication & Security
JWT_SECRET="change_me_super_secret_jwt_key_at_least_32_chars_long_12345"
JWT_EXPIRES_IN="7d"

# AES-256-GCM Encryption Key (64 hex characters / 32 bytes) for IPTV credentials
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Streaming Token Secret
STREAM_TOKEN_SECRET="change_me_stream_token_secret_for_manifest_protection"

# Initial Admin Seeder Credentials
ADMIN_NAME="Administrador GolStream"
ADMIN_EMAIL="admin@golstream.pro"
ADMIN_PASSWORD="AdminSecurePassword2026!"

# Allowed Origins (comma separated)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,http://localhost,capacitor://localhost"
